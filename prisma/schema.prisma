generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  dni       String   @unique
  password  String
  username  String   @unique
  createdAt DateTime @default(now())
  pacientes Paciente[]
  alumnos   Alumno[]
}

model Paciente {
  id               String    @id @default(uuid())
  fullName         String
  dni              String    @unique
  phone            String?
  email            String?
  gender           String?
  age              Int?
  height           Float?
  weight           Float?
  notes            String?
  sessionsCount    Int       @default(0)
  totalSessions    Int       @default(0)
  lastSessionDate  DateTime?
  healthInsurance  String?
  isActive         Boolean   @default(true)
  dischargeDate    DateTime?
  expirationDate   DateTime?
  diagnoses        String[]
  createdAt        DateTime  @default(now())
  rutinas          Rutina[]
  adminId          String?
  admin            Admin?    @relation(fields: [adminId], references: [id])
  notasClinicas    NotaClinica[]
  pesoLogs         EjercicioPesoLog[]
}

model Alumno {
  id               String    @id @default(uuid())
  fullName         String
  dni              String    @unique
  phone            String?
  email            String?
  gender           String?
  age              Int?
  height           Float?
  weight           Float?
  notes            String?
  sessionsCount    Int       @default(0)
  totalSessions    Int       @default(0)
  lastSessionDate  DateTime?
  healthInsurance  String?
  isActive         Boolean   @default(true)
  dischargeDate    DateTime?
  expirationDate   DateTime?
  diagnoses        String[]
  createdAt        DateTime  @default(now())
  rutinas          Rutina[]
  adminId          String?
  admin            Admin?    @relation(fields: [adminId], references: [id])
  notasClinicas    NotaClinica[]
  pesoLogs         EjercicioPesoLog[]
}

model Ejercicio {
  id          String   @id @default(uuid())
  name        String
  description String
  categories  String[]
  videoUrl    String?
  createdAt   DateTime @default(now())
}

model Rutina {
  id          String   @id @default(uuid())
  name        String
  description String
  dias        Dia[]
  pacienteId  String?
  paciente    Paciente? @relation(fields: [pacienteId], references: [id])
  alumnoId    String?
  alumno      Alumno?   @relation(fields: [alumnoId], references: [id])
  createdAt   DateTime @default(now())
}

model Dia {
  id         String            @id @default(uuid())
  name       String
  rutinaId   String
  rutina     Rutina            @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ejercicios EjercicioEnDia[]
  createdAt  DateTime          @default(now())
}

model EjercicioEnDia {
  id         String    @id @default(uuid())
  diaId      String
  dia        Dia       @relation(fields: [diaId], references: [id], onDelete: Cascade)
  exerciseId String
  sets       Int
  reps       Int
  weight     Int?      @default(0)
  time       String?
  intervalo  String?
  isCircuit  Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model NotaClinica {
  id          String   @id @default(uuid())
  title       String
  description String
  photoUrl    String?
  pacienteId  String?
  paciente    Paciente? @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  alumnoId    String?
  alumno      Alumno?   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model EjercicioPesoLog {
  id               String    @id @default(uuid())
  ejercicioEnDiaId String?
  exerciseId       String
  rutinaId         String?
  pacienteId       String?
  alumnoId         String?
  weight           Int
  date             DateTime  @default(now())
  createdAt        DateTime  @default(now())

  paciente         Paciente? @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  alumno           Alumno?   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
}


